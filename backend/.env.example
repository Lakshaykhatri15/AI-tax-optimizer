# ── Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/taxoptimizer

# ── Auth
SECRET_KEY=replace-with-python-secrets.token_hex(32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Advisor
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Redis
REDIS_URL=redis://localhost:6379

# ── Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_EMAIL=noreply@taxoptimizer.in

# ── Zerodha Kite (optional)
ZERODHA_API_KEY=your-kite-api-key
ZERODHA_API_SECRET=your-kite-api-secret

# ── App
ENVIRONMENT=development
LOG_LEVEL=INFO
